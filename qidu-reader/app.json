{
  "expo": {
    "name": "众阅",
    "slug": "zhongyue-reader",
    "version": "0.10.3",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qidu.reader",
      "buildNumber": "13"
    },
    "android": {
      "package": "com.qidu.reader",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/zhongyue-B-1024.png",
        "backgroundColor": "#FBF5E8"
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-font",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/zhongyue-B-1024.png",
          "imageWidth": 200,
          "backgroundColor": "#FBF5E8",
          "dark": {
            "image": "./assets/brand/zhongyue-C-1024.png",
            "backgroundColor": "#18332A"
          }
        }
      ]
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/brand/zhongyue-B-1024.png"
  }
}
